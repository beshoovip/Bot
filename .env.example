# انسخه إلى .env محليًا (لا يُودَع). في الاستضافة ضع القيم في لوحة المتغيرات (Environment) وليس في المستودع.
NODE_ENV=production
PORT=8080
# رابط قاعدة PostgreSQL (Neon/Render/…)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# true عادةً للقواعد المستضافة؛ false لقاعدة محلية بلا SSL
DATABASE_SSL=true
# أصول الواجهة المسموحة (مفصولة بفواصل). تطبيق Capacitor على أندرويد يستخدم https://localhost
CORS_ORIGINS=https://localhost,capacitor://localhost
# خلف وكيل عكسي (Render/Heroku/…): true ليُقرأ IP الحقيقي لتحديد المعدل
TRUST_PROXY=true
LOG_LEVEL=info
# تشغيل الترحيلات تلقائيًا عند الإقلاع (false لإيقافه)
RUN_MIGRATIONS=true
