{
  "name": "caravan-road",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "لعبة MMORPG ثنائية الأبعاد (منظور مائل) لنظام المهن والقوافل — تصميم أصلي",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/shared/**/*.test.js\" \"tests/server/**/*.test.js\" \"tests/contract/**/*.test.js\" \"tests/client/**/*.test.js\"",
    "test:unit": "node --test \"tests/shared/**/*.test.js\" \"tests/server/**/*.test.js\" \"tests/contract/**/*.test.js\" \"tests/client/**/*.test.js\"",
    "test:db": "bash tests/db/run.sh",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "gen:seed": "node server/scripts/gen-seed.js",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:ui": "node --test \"tests/ui/**/*.test.js\"",
    "test:all": "npm test && npm run test:db && npm run test:integration && npm run test:ui"
  }
}
